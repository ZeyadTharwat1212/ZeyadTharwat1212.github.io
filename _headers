# Cloudflare Pages headers (GitHub Pages ignores this file). The app updates itself by re-fetching these past every
# cache, so they must never be served stale.
/sw.js
  Cache-Control: no-cache
/kateb/version.json
  Cache-Control: no-cache, no-store
/*.html
  Cache-Control: no-cache
/*.webmanifest
  Cache-Control: no-cache

# big, rarely changing third-party files: a week in the browser cache
/kateb/vendor/*
  Cache-Control: public, max-age=604800
/kateb/dict/*
  Cache-Control: public, max-age=604800
