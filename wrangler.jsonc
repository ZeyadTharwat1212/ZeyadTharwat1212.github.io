// Cloudflare Workers (static assets) — lets the «Workers & Pages → Create an app → connect repo» flow deploy this
// static site with the default `npx wrangler deploy`. GitHub Pages ignores this file.
// Build command in the Cloudflare project: `rm -rf .git .github tests` (nothing but the site is uploaded).
{
  "name": "zeyadtharwat1212-github-io",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./", "not_found_handling": "none" }
}
