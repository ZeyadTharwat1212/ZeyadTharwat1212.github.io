// Cloudflare Workers (static assets). `wrangler deploy` first runs the build command below, which copies only the
// site into dist/ (never .git or tests), then uploads dist/ as static assets. GitHub Pages ignores this file.
// In the Cloudflare project leave «Build command» EMPTY and keep «Deploy command» = npx wrangler deploy.
{
  "name": "zeyadtharwat1212-github-io",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "rm -rf dist && mkdir dist && cp -r kateb kateb.html hanan.html index.html setup.html sw.js kateb.webmanifest hanan.webmanifest _headers dist/" },
  "assets": { "directory": "./dist", "not_found_handling": "none" }
}
